{
  "expo": {
    "name": "Mi Cava",
    "slug": "mi-cava",
    "scheme": "micava",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F1E6",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B1F2A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.micava.app"
    },
    "android": {
      "package": "com.micava.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6B1F2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Cava usa la cámara para escanear códigos de barras y tomar fotos de tus productos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mi Cava necesita ver tus fotos para elegir la foto de un producto o de un conteo.",
          "cameraPermission": "Mi Cava usa la cámara para tomar fotos de tus productos y conteos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6B1F2A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
